PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/projectforge

JWT_SECRET=projectforge_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Storage Configuration (Supabase / S3 / Cloudflare R2 / Local)
STORAGE_PROVIDER=supabase
STORAGE_LOCAL_PATH=./storage/protected
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_BUCKET_NAME=campusget-storage
STORAGE_ENDPOINT=https://s3.amazonaws.com
STORAGE_BUCKET=projectforge-protected-packages
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
STORAGE_REGION=ap-south-1

# Email Service Configuration
# Option 1 (Recommended for Cloud/Render): Resend API (Free 3,000 emails/mo)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=CampusGet <onboarding@resend.dev>

# Option 2 (Alternative): Gmail App Password or Brevo SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=campusget.in@gmail.com
# SMTP_PASS=your_16_digit_app_password

WHATSAPP_NUMBER=918081220303
BRAND_NAME=CampusGet
